---
// scoreboard.astro — THE HONESTY BOARD. Every forecast we log, graded against
// METAR/VABB. Zero-JS: numbers baked at build from data/log.csv + public/model.json.
//
// ROBUSTNESS: loadLogCsv({ required: true }) THROWS if the diary is missing or
// corrupt — the build fails instead of shipping a silent empty "Couldn't read
// the log" page that a service worker can cache forever.
import Page from "../layouts/Page.astro";
import { loadLogCsv, loadModelJson } from "../lib/log-csv.js";
import { reliabilityBins, contingencyScores } from "../lib/skill.js";

// Must match pipeline/train.py RAIN_MM and nowcast.js RAIN_THRESHOLD_MM.
const RAIN_TH = 0.3;
const MIN_ROWS = 200;
const RAIN_PROB = 0.5;
const STALE_WARN_H = 6;
const STALE_FAIL_H = 24;

type Row = Record<string, string>;
type Model = {
  type?: string;
  weights?: number[];
  intercept?: number;
  features?: string[];
  trained_at?: string;
  brier?: number;
  raw_brier?: number;
  clim_brier?: number;
  n_train?: number;
  n_test?: number;
};

// Fail the build loudly if data/log.csv is missing/unreadable. Empty diary
// (header only) is allowed → rows=[] → "No snapshots logged yet."
const logLoad = loadLogCsv({ required: true });
const data: Row[] = (logLoad.rows ?? []) as Row[];
const logPathUsed = logLoad.path;

const modelLoad = loadModelJson();
const model = modelLoad.model as Model | null;
if (modelLoad.error) {
  // Model is optional for the raw-stats half of the board — warn, don't fail.
  console.warn(`[scoreboard] ${modelLoad.error}`);
}
// Always true now that required load throws on failure; kept so templates stay clear.
const readOk = true;

const num = (v: string): number => {
  const n = Number(v);
  return Number.isFinite(n) ? n : 0;
};
const isLabelled = (r: Row) => String(r.observed_raining ?? "").trim() !== "";

const totalRows = data.length;
const runs = new Set(data.map((r) => r.issued_at)).size;
const labelled = data.filter(isLabelled);
const nLab = labelled.length;
const rainHours = labelled.filter((r) => num(r.observed_raining) === 1).length;
const pending = totalRows - nLab;

// issued_at is "YYYY-MM-DDTHH:00" UTC from the collector
const lastIssued = data.reduce((m, r) => (r.issued_at > m ? r.issued_at : m), "");
let hoursStale: number | null = null;
if (lastIssued) {
  const issuedMs = Date.parse(lastIssued.length === 16 ? `${lastIssued}:00Z` : lastIssued);
  if (Number.isFinite(issuedMs)) hoursStale = (Date.now() - issuedMs) / 3_600_000;
}
const staleLevel =
  hoursStale == null ? "unknown"
  : hoursStale > STALE_FAIL_H ? "critical"
  : hoursStale > STALE_WARN_H ? "warn"
  : "ok";
const lastIssuedLabel = lastIssued ? lastIssued.replace("T", " ") + " UTC" : null;

// Raw forecast on ALL graded hours (product threshold ≥ 0.3 mm/h)
let TP = 0, FP = 0, FN = 0, TN = 0;
for (const r of labelled) {
  const calledRain = num(r.fc_bestmatch_mm) >= RAIN_TH;
  const didRain = num(r.observed_raining) === 1;
  if (calledRain && didRain) TP++;
  else if (calledRain && !didRain) FP++;
  else if (!calledRain && didRain) FN++;
  else TN++;
}
const rainCalls = TP + FP;
const observedRain = TP + FN;

const pctVal = (n: number, d: number) => (d ? (100 * n) / d : 0);
const fmtPct = (n: number, d: number) => (d ? pctVal(n, d).toFixed(1) + "%" : "—");
const fmtBrier = (v: number | null | undefined) =>
  v == null || !Number.isFinite(v) ? "—" : v.toFixed(4);
const fmtBss = (v: number | null | undefined) =>
  v == null || !Number.isFinite(v) ? "—" : (v >= 0 ? "+" : "") + (100 * v).toFixed(1) + "%";
// A rate in [0,1] as a percentage. Distinct from fmtPct, which takes n/d.
const fmtRate = (v: number | null | undefined) =>
  v == null || !Number.isFinite(v) ? "—" : (100 * v).toFixed(1) + "%";
const fmtRatio = (v: number | null | undefined) =>
  v == null || !Number.isFinite(v) ? "—" : v.toFixed(2);

const baseRate = fmtPct(observedRain, nLab);
const pod = fmtPct(TP, observedRain);
const far = fmtPct(FP, rainCalls);
const accuracy = fmtPct(TP + TN, nLab);

// Holdout = train.py: sort by valid_at, 80/20, Brier vs raw + clim
function sigmoid(z: number) {
  const c = Math.max(-60, Math.min(60, z));
  return 1 / (1 + Math.exp(-c));
}
function rowFeatures(r: Row): number[] {
  const bm = num(r.fc_bestmatch_mm);
  const ecRaw = String(r.fc_ecmwf_mm ?? "").trim();
  const ec = ecRaw === "" ? bm : num(r.fc_ecmwf_mm);
  const hour = num(r.hour);
  return [
    bm, ec,
    Math.sin((2 * Math.PI * hour) / 24),
    Math.cos((2 * Math.PI * hour) / 24),
    num(r.recent_rain_mm),
  ];
}
function predictProba(m: Model, feats: number[]) {
  const z = (m.intercept ?? 0) + (m.weights ?? []).reduce((s, w, i) => s + w * (feats[i] ?? 0), 0);
  return sigmoid(z);
}
function brierScore(probs: number[], actual: number[]) {
  if (!probs.length) return null;
  let s = 0;
  for (let i = 0; i < probs.length; i++) s += (probs[i] - actual[i]) ** 2;
  return s / probs.length;
}

const enoughData = nLab >= MIN_ROWS;
const isLogistic = !!model && model.type === "logistic" && Array.isArray(model.weights);

type Holdout = {
  nTrain: number; nTest: number;
  modelBrier: number | null; rawBrier: number | null; climBrier: number | null;
  bssRaw: number | null; bssClim: number | null;
  mTP: number; mFP: number; mFN: number; mTN: number;
  beatsRaw: boolean; beatsClim: boolean; status: string;
  reliability: { lo: number; hi: number; n: number; forecast: number | null; observed: number | null }[];
  pod: number | null; far: number | null; csi: number | null; bias: number | null;
};

// 5 bins, not 10: with a few hundred holdout rows a 10-bin table is mostly
// empty cells, and an "observed" frequency over 3 samples is noise, not signal.
const RELIABILITY_BINS = 5;

let holdout: Holdout | null = null;
if (enoughData) {
  const sorted = [...labelled].sort((a, b) =>
    a.valid_at < b.valid_at ? -1 : a.valid_at > b.valid_at ? 1 : 0,
  );
  const split = Math.floor(sorted.length * 0.8);
  const trainRows = sorted.slice(0, split);
  const testRows = sorted.slice(split);
  const yte = testRows.map((r) => num(r.observed_raining));
  if (new Set(yte).size >= 2 && testRows.length > 0) {
    const base = trainRows.reduce((s, r) => s + num(r.observed_raining), 0) / trainRows.length;
    const Xte = testRows.map(rowFeatures);
    const rawB = brierScore(Xte.map((x) => (x[0] >= RAIN_TH ? 1 : 0)), yte)!;
    const climB = brierScore(Xte.map(() => base), yte)!;
    let modelB: number | null = null;
    let mTP = 0, mFP = 0, mFN = 0, mTN = 0;
    let reliability: Holdout["reliability"] = [];
    if (isLogistic) {
      const probs = Xte.map((x) => predictProba(model!, x));
      modelB = brierScore(probs, yte);
      for (let i = 0; i < testRows.length; i++) {
        const called = probs[i] >= RAIN_PROB;
        const did = yte[i] === 1;
        if (called && did) mTP++;
        else if (called && !did) mFP++;
        else if (!called && did) mFN++;
        else mTN++;
      }
      reliability = reliabilityBins(probs, yte, RELIABILITY_BINS);
    }
    const scores = contingencyScores({ tp: mTP, fp: mFP, fn: mFN, tn: mTN });
    const beatsRaw = modelB != null && modelB <= rawB;
    const beatsClim = modelB != null && modelB <= climB;
    holdout = {
      nTrain: trainRows.length, nTest: testRows.length,
      modelBrier: modelB, rawBrier: rawB, climBrier: climB,
      bssRaw: modelB != null && rawB > 0 ? 1 - modelB / rawB : null,
      bssClim: modelB != null && climB > 0 ? 1 - modelB / climB : null,
      mTP, mFP, mFN, mTN, beatsRaw, beatsClim,
      status: !isLogistic ? "raw-fallback" : beatsRaw && beatsClim ? "ok" : "degraded",
      reliability,
      pod: scores.pod, far: scores.far, csi: scores.csi, bias: scores.bias,
    };
  }
}

const live = enoughData && isLogistic;
const pctToLive = Math.max(0, Math.min(100, Math.round((nLab / MIN_ROWS) * 100)));
const remaining = Math.max(0, MIN_ROWS - nLab);
const builtAt = new Date().toISOString().slice(0, 16).replace("T", " ") + " UTC";
const lastGraded = labelled.reduce((m, r) => (r.valid_at > m ? r.valid_at : m), "");
const dataThrough = lastGraded ? lastGraded.replace("T", " ") + " IST" : null;
const trainedAt = model?.trained_at
  ? model.trained_at.replace("T", " ").replace("Z", " UTC")
  : null;

const title = "पाऊस · Scoreboard — Mumbai rain model vs raw forecast";
const description =
  "Honesty board for Mumbai rain: every logged forecast graded against METAR at VABB. Live Brier for the calibrated model vs raw Open-Meteo and climatology on a time-ordered holdout.";
---
<Page title={title} description={description} canonicalPath="/scoreboard" active="scoreboard">
  <section class="sb-hero">
    <p class="sb-eyebrow">The honesty board</p>
    <h1 class="sb-title">Model vs.<em> raw forecast</em></h1>
    <p class="sb-lede">
      Every forecast we publish gets logged, then graded against what Mumbai's
      airport actually observed — no cherry-picking. The calibrated model only
      ships when it beats <em>both</em> the raw forecast and climatology on a
      time-ordered holdout. If it can't, it doesn't ship.
    </p>
  </section>

  {/* Stale / collect health — never silent when the diary freezes */}
  {readOk && totalRows > 0 && staleLevel !== "ok" && (
    <section
      class={`sb-banner sb-banner-${staleLevel}`}
      role="status"
      aria-live="polite"
    >
      <p class="sb-banner-h">
        {staleLevel === "critical"
          ? "Collection looks stale"
          : staleLevel === "warn"
            ? "Collection running late"
            : "Collection status unknown"}
      </p>
      <p class="sb-banner-p">
        {lastIssuedLabel
          ? `Last snapshot issued ${lastIssuedLabel}`
          : "No issued_at stamps in the log."}
        {hoursStale != null && (
          <> · ~{hoursStale.toFixed(1)} hours ago</>
        )}
        {staleLevel === "critical" && (
          <> · Numbers below may not reflect the last day of weather.</>
        )}
      </p>
    </section>
  )}

  {readOk && totalRows === 0 && (
    <section class="sb-empty" role="status">
      <p class="sb-empty-h">No snapshots logged yet.</p>
      <p class="sb-empty-p">
        The hourly cron hasn't written to <code>data/log.csv</code> yet. This board
        fills in automatically the moment it does.
      </p>
    </section>
  )}

  {readOk && totalRows > 0 && (
    <>
      <section class="sb-card sb-progress" aria-labelledby="sb-progress-h">
        <div class="sb-progress-top">
          <p class="sb-klabel" id="sb-progress-h">
            {live
              ? holdout?.status === "ok"
                ? "Calibrated model — beating baselines"
                : holdout?.status === "degraded"
                  ? "Calibrated model — under pressure"
                  : "Calibrated model — live"
              : enoughData
                ? "Serving raw forecast (no logistic champion)"
                : "Progress to a live model"}
          </p>
          <p class="sb-progress-count">
            <span class="sb-now">{nLab}</span><span class="sb-of"> / {MIN_ROWS}</span>
            <span class="sb-unit"> labelled</span>
          </p>
        </div>
        <div class="sb-bar" role="img"
             aria-label={`${nLab} of ${MIN_ROWS} labelled rows`}>
          <span class="sb-bar-fill" style={`width:${pctToLive}%`}></span>
        </div>
        <p class="sb-progress-note">
          {live
            ? `Logistic champion trained ${trainedAt ?? "—"}. Holdout recomputed at build on the latest diary (same 80/20 time split as train.py).`
            : enoughData
              ? "Enough graded data, but model.json is not a logistic champion — UI falls back to the raw Open-Meteo path."
              : `${remaining} more labelled hours to go. The model trains daily on GitHub Actions and only goes live at ${MIN_ROWS} graded rows — and only if it beats raw + climatology + the current champion.`}
        </p>
      </section>

      {/* Live model holdout — the missing piece that used to only claim this */}
      {holdout && (
        <section aria-labelledby="sb-model-h">
          <h2 class="sb-h2" id="sb-model-h">Holdout skill · model vs baselines</h2>
          <p class="sb-section-lede">
            Time-ordered last 20% of graded hours
            ({holdout.nTest.toLocaleString()} test · {holdout.nTrain.toLocaleString()} train).
            Lower Brier is better. Raw rain call = forecast
            <span class="sb-mono"> ≥&nbsp;{RAIN_TH}&nbsp;mm·h⁻¹</span>
            (same as the Now page). Logistic rain call =
            <span class="sb-mono"> p&nbsp;≥&nbsp;{RAIN_PROB}</span>.
          </p>
          <dl class="sb-stats sb-stats-brier">
            <div class="sb-stat">
              <dt>Model Brier</dt>
              <dd class="sb-n">{fmtBrier(holdout.modelBrier)}</dd>
              <p class="sb-stat-sub">{holdout.status === "ok" ? "live champion" : holdout.status}</p>
            </div>
            <div class="sb-stat">
              <dt>Raw Brier</dt>
              <dd class="sb-n">{fmtBrier(holdout.rawBrier)}</dd>
              <p class="sb-stat-sub">hard ≥{RAIN_TH} mm call</p>
            </div>
            <div class="sb-stat">
              <dt>Climatology</dt>
              <dd class="sb-n">{fmtBrier(holdout.climBrier)}</dd>
              <p class="sb-stat-sub">train base rate</p>
            </div>
            <div class="sb-stat">
              <dt>Skill vs raw</dt>
              <dd class="sb-n">{fmtBss(holdout.bssRaw)}</dd>
              <p class="sb-stat-sub">Brier skill score</p>
            </div>
          </dl>
          <ul class="sb-metrics">
            <li class={holdout.beatsRaw ? "" : "sb-m-flag"}>
              <span class="sb-m-k">Beats raw?</span>
              <span class="sb-m-v">{holdout.beatsRaw ? "yes" : "no"}</span>
              <span class="sb-m-d">required for promotion</span>
            </li>
            <li class={holdout.beatsClim ? "" : "sb-m-flag"}>
              <span class="sb-m-k">Beats clim?</span>
              <span class="sb-m-v">{holdout.beatsClim ? "yes" : "no"}</span>
              <span class="sb-m-d">required for promotion</span>
            </li>
            <li>
              <span class="sb-m-k">Skill vs clim</span>
              <span class="sb-m-v">{fmtBss(holdout.bssClim)}</span>
              <span class="sb-m-d">positive = better than always-guess base rate</span>
            </li>
            {model?.brier != null && (
              <li>
                <span class="sb-m-k">Stored at promote</span>
                <span class="sb-m-v">{fmtBrier(model.brier)}</span>
                <span class="sb-m-d">model.json snapshot from last promotion</span>
              </li>
            )}
          </ul>
          {isLogistic && (
            <p class="sb-reading sb-reading-ok">
              On the holdout, logistic p≥{RAIN_PROB}:
              {" "}{holdout.mTP} hits · {holdout.mFP} false alarms · {holdout.mFN} misses · {holdout.mTN} correct dry.
            </p>
          )}

          {isLogistic && (
            <>
              <h3 class="sb-h3">At the decision threshold (p≥{RAIN_PROB})</h3>
              <p class="sb-note">
                What the numbers above mean if you actually act on them. CSI ignores the
                many correct-dry hours, so unlike accuracy it can't be flattered by a
                dry month.
              </p>
              <dl class="sb-stats">
                <div class="sb-stat">
                  <dt>POD</dt>
                  <dd class="sb-n">{fmtRate(holdout.pod)}</dd>
                  <p class="sb-stat-sub">of rainy hours we called</p>
                </div>
                <div class="sb-stat">
                  <dt>FAR</dt>
                  <dd class="sb-n">{fmtRate(holdout.far)}</dd>
                  <p class="sb-stat-sub">of rain calls that were wrong</p>
                </div>
                <div class="sb-stat">
                  <dt>CSI</dt>
                  <dd class="sb-n">{fmtRate(holdout.csi)}</dd>
                  <p class="sb-stat-sub">threat score, dry hours excluded</p>
                </div>
                <div class="sb-stat">
                  <dt>Bias</dt>
                  <dd class="sb-n">{fmtRatio(holdout.bias)}</dd>
                  <p class="sb-stat-sub">1.00 = we call rain as often as it rains</p>
                </div>
              </dl>

              <h3 class="sb-h3">Reliability — when we say X%, does it rain X%?</h3>
              <p class="sb-note">
                Brier alone hides miscalibration. A well-calibrated model has
                <em>observed</em> close to <em>forecast</em> on every row; that is the
                diagonal a reliability diagram draws. Rows with no holdout hours are
                left blank rather than shown as zero.
              </p>
              <table class="sb-table sb-reliability">
                <thead>
                  <tr>
                    <th scope="col">Forecast band</th>
                    <th scope="col">Hours</th>
                    <th scope="col">Mean forecast</th>
                    <th scope="col">Observed</th>
                  </tr>
                </thead>
                <tbody>
                  {holdout.reliability.map((b) => (
                    <tr>
                      <th scope="row">
                        {Math.round(100 * b.lo)}–{Math.round(100 * b.hi)}%
                      </th>
                      <td>{b.n || "—"}</td>
                      <td>{fmtRate(b.forecast)}</td>
                      <td>{fmtRate(b.observed)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )}
        </section>
      )}

      <section aria-labelledby="sb-collected-h">
        <h2 class="sb-h2" id="sb-collected-h">What we've collected</h2>
        <dl class="sb-stats">
          <div class="sb-stat">
            <dt>Snapshots logged</dt>
            <dd class="sb-n">{totalRows.toLocaleString()}</dd>
            <p class="sb-stat-sub">across {runs} hourly run{runs === 1 ? "" : "s"}</p>
          </div>
          <div class="sb-stat">
            <dt>Graded rows</dt>
            <dd class="sb-n">{nLab.toLocaleString()}</dd>
            <p class="sb-stat-sub">observed by METAR</p>
          </div>
          <div class="sb-stat">
            <dt>Observed rain hours</dt>
            <dd class="sb-n">{rainHours.toLocaleString()}</dd>
            <p class="sb-stat-sub">of {nLab.toLocaleString()} graded</p>
          </div>
          <div class="sb-stat">
            <dt>Awaiting a grade</dt>
            <dd class="sb-n">{pending.toLocaleString()}</dd>
            <p class="sb-stat-sub">future hours, not yet observed</p>
          </div>
        </dl>
      </section>

      <section aria-labelledby="sb-raw-h">
        <h2 class="sb-h2" id="sb-raw-h">The raw forecast's record</h2>
        <p class="sb-section-lede">
          On <em>all</em> {nLab.toLocaleString()} graded hours (not just the holdout),
          counting a rain call whenever the raw forecast read
          <span class="sb-mono"> ≥&nbsp;{RAIN_TH}&nbsp;mm·h⁻¹</span>
          — the same line the Now page draws.
        </p>

        {nLab === 0 ? (
          <p class="sb-empty-p sb-inset">
            No graded hours yet — METAR hasn't labelled any logged hour. Grades
            appear as past forecast hours get observed.
          </p>
        ) : (
          <>
            <table class="sb-matrix">
              <caption class="sb-vh">
                Raw forecast outcomes versus observed rain, on {nLab} graded hours.
              </caption>
              <thead>
                <tr>
                  <td></td>
                  <th scope="col">Observed<br /><span class="sb-th-strong">rain</span></th>
                  <th scope="col">Observed<br /><span class="sb-th-strong">dry</span></th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">Forecast rain<span class="sb-th-sub">≥ {RAIN_TH} mm</span></th>
                  <td class="sb-cell sb-hit">
                    <span class="sb-cell-n">{TP}</span><span class="sb-cell-l">hits</span>
                  </td>
                  <td class="sb-cell sb-fa">
                    <span class="sb-cell-n">{FP}</span><span class="sb-cell-l">false alarms</span>
                  </td>
                </tr>
                <tr>
                  <th scope="row">Forecast dry<span class="sb-th-sub">&lt; {RAIN_TH} mm</span></th>
                  <td class="sb-cell sb-miss">
                    <span class="sb-cell-n">{FN}</span><span class="sb-cell-l">misses</span>
                  </td>
                  <td class="sb-cell sb-ok">
                    <span class="sb-cell-n">{TN}</span><span class="sb-cell-l">correct dry</span>
                  </td>
                </tr>
              </tbody>
            </table>

            <ul class="sb-metrics">
              <li>
                <span class="sb-m-k">Base rate</span>
                <span class="sb-m-v">{baseRate}</span>
                <span class="sb-m-d">of graded hours actually had rain</span>
              </li>
              <li>
                <span class="sb-m-k">Detection · POD</span>
                <span class="sb-m-v">{pod}</span>
                <span class="sb-m-d">of {observedRain} rain hours, {TP} were forecast</span>
              </li>
              <li class="sb-m-flag">
                <span class="sb-m-k">False-alarm ratio</span>
                <span class="sb-m-v">{far}</span>
                <span class="sb-m-d">of {rainCalls} rain calls, {FP} were wrong</span>
              </li>
              <li>
                <span class="sb-m-k">Raw agreement</span>
                <span class="sb-m-v">{accuracy}</span>
                <span class="sb-m-d">forecast matched observation</span>
              </li>
            </ul>

            {rainCalls > 0 && (
              <p class="sb-reading">
                The raw forecast cries wolf: {rainCalls} rain calls, only {TP} right —
                and it still missed {FN} of {observedRain} real rain hours. Cutting
                those false alarms is the whole job of the calibrated model.
              </p>
            )}
          </>
        )}
      </section>

      <section aria-labelledby="sb-gate-h">
        <h2 class="sb-h2" id="sb-gate-h">Promotion gate</h2>
        <p class="sb-section-lede">
          Daily retrain on GitHub Actions. A candidate ships only when its holdout
          Brier is strictly no worse than raw, climatology, <em>and</em> the current
          champion. A worse model can never replace a better one; a champion that
          loses to raw or clim is demoted to raw passthrough.
        </p>
        <ol class="sb-gate">
          <li><span class="sb-gate-n">1</span> Beat the <strong>raw forecast</strong> (≥{RAIN_TH} mm hard call).</li>
          <li><span class="sb-gate-n">2</span> Beat <strong>climatology</strong> (train-set base rate).</li>
          <li><span class="sb-gate-n">3</span> Beat the current <strong>champion</strong> model.</li>
          <li><span class="sb-gate-n">4</span> Otherwise — rejected. The champion stays (or demotes to raw).</li>
        </ol>
      </section>
    </>
  )}

  <footer slot="footer" class="sb-foot">
    <p>
      Forecast: <a href="https://open-meteo.com/" rel="noopener">Open-Meteo</a>.
      Ground truth: NOAA METAR, station VABB (Mumbai airport).
      Health: <a href="/metrics.json"><code>metrics.json</code></a>.
    </p>
    <p class="sb-built">Baked at build · {builtAt}</p>
    {logPathUsed && <p class="sb-built">Log · {logPathUsed.replace(/\\/g, "/").split("/").slice(-2).join("/")}</p>}
    {dataThrough && <p class="sb-built">Data through {dataThrough}</p>}
