---
// Per-place SEO pages — one static page per catalog row (/bandra, /chennai, …).
// Each defaults the app to that place and carries place-specific title/h1/meta.
import Almanac from "../layouts/Almanac.astro";
import { slugify } from "../lib/slug.js";
import localities from "../data/localities.json";

export function getStaticPaths() {
  return localities.map((l) => ({
    params: { locality: slugify(l.name) },
    props: { loc: l },
  }));
}

const { loc } = Astro.props;
const area = loc.name;

const title = `पाऊस · Rain in ${area} right now — next 2 hours`;
const where = loc.metro === "Mumbai" ? `${area}, Mumbai` : (loc.state ? `${area}, ${loc.state}` : area);
const description =
  `Will it rain in ${where} in the next 2 hours? A live, 2-second verdict for ${area} — leave now or wait.`;
---
<Almanac
  title={title}
  description={description}
  heroHeading={`Rain in ${area} right now`}
  defaultLocality={area}
  canonicalPath={`/${slugify(area)}`}
/>
