---
// Per-locality SEO pages — one static, pre-rendered page per area (/bandra,
// /kandivali, … all 36). Each defaults the app to that locality and carries
// locality-specific title/h1/meta for "rain in <area> right now".
import Almanac from "../layouts/Almanac.astro";
import { slugify } from "../lib/slug.js";
import localities from "../data/localities.json";

export function getStaticPaths() {
  return localities.map((l) => ({
    params: { locality: slugify(l.name) },
    props: { loc: l },
  }));
}

const { loc } = Astro.props;
const area = loc.name;

const title = `पाऊस · Rain in ${area} right now — next 2 hours`;
const description =
  `Will it rain in ${area}, Mumbai in the next 2 hours? A live, 2-second verdict ` +
  `for ${area} — leave now or wait. Flood-risk watch + calibrated forecast.`;
---
<Almanac
  title={title}
  description={description}
  heroHeading={`Rain in ${area} right now`}
  defaultLocality={area}
  canonicalPath={`/${slugify(area)}`}
/>
